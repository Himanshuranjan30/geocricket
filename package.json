{
  "name": "pitchmap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "hero-art": "tsx --tsconfig tsconfig.json scripts/hero-art.mts",
    "legend-art": "tsx --tsconfig tsconfig.json scripts/legend-art.mts",
    "draft": "tsx --conditions=react-server --env-file=.env.local --tsconfig tsconfig.json scripts/draft.ts",
    "db:seed": "tsx src/db/seed.ts",
    "postinstall": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/ && mkdir -p public/flags && cp node_modules/country-flag-icons/3x2/*.svg public/flags/",
    "db:push:prod": "node --env-file=.env.neon node_modules/drizzle-kit/bin.cjs push --force",
    "db:seed:prod": "node --env-file=.env.neon --import tsx src/db/seed.ts",
    "deploy:staging": "sh scripts/deploy-staging.sh",
    "deploy:prod": "vercel deploy --prod --yes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@anthropic-ai/vertex-sdk": "^0.20.0",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/oidc": "^3.8.9",
    "better-auth": "^1.7.6",
    "country-flag-icons": "^1.6.20",
    "dodopayments": "^2.52.0",
    "dodopayments-checkout": "^1.9.9",
    "drizzle-orm": "^0.45.3",
    "google-auth-library": "^10.9.1",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.23.0"
}
