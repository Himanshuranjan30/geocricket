# Production database (Neon). Leave unset locally to use embedded PGlite in ./.pglite
DATABASE_URL=

# Public site URL, used in share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional): Google Analytics 4 measurement id (set in Production only)
NEXT_PUBLIC_GA_ID=

# Ads (optional): AdSense publisher id and slot ids
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_RESULTS=
NEXT_PUBLIC_AD_SLOT_MOMENTS=
NEXT_PUBLIC_AD_SLOT_HUBS=
NEXT_PUBLIC_AD_SLOT_RAIL=

# Satellite tiles. Default: EOX Sentinel-2 cloudless 2016 (CC BY 4.0). Self-host before scale.
NEXT_PUBLIC_SATELLITE_TILES=

# Auth (Better Auth + Google). Secret: `openssl rand -base64 32`. URL: the site origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
